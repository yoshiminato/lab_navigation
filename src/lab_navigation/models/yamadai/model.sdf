      </visual>
      <collision name="simple_collision">
        <geometry>
          <mesh>
            <uri>model://yamadai/meshes/yamadai.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
             <mu>1.00</mu>
             <mu2>1.00</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
