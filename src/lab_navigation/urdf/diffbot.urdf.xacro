<?xml version="1.0"?>
<robot name="diffbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- launch から渡される -->
  <xacro:arg name="use_mock_hardware" default="false" />

  <!-- Material definitions -->
  <xacro:include
    filename="$(find ros2_control_demo_description)/diffbot/urdf/diffbot.materials.xacro" />

  <!-- ros2_control definition -->
  <xacro:include
    filename="$(find ros2_control_diff_drive)/ros2_control/diffbot.ros2_control.xacro" />

  <xacro:macro name="diffbot" params="prefix">

    <!-- =========================
         Real robot parameters
         ========================= -->

    <xacro:property name="PI" value="3.1415926535897931" />

    <!-- Robot body -->
    <xacro:property name="base_length" value="0.50" />
    <xacro:property name="base_width"  value="0.40" />
    <xacro:property name="base_height" value="0.60" />

    <!--
      車体下端の地上高。
      今回は 10 cm とする。
      base_link は車体の幾何学中心なので、
      base_link の地上高 = 0.10 + 0.60 / 2 = 0.40 m
    -->
    <xacro:property name="base_bottom_clearance" value="0.10" />

    <!-- Placeholder body mass -->
    <xacro:property name="base_mass" value="0.3" />

    <!-- Main wheels -->
    <xacro:property name="wheel_mass" value="0.3" />
    <xacro:property name="wheel_len" value="0.10" />
    <xacro:property name="wheel_radius" value="0.135" />
    <xacro:property name="wheel_separation" value="0.53" />

    <!-- Auxiliary wheels / ball casters -->
    <!--
      現段階では直径10 cmの球として簡略化。
      実車体（X=0.50 m, Y=0.40 m）の四隅から X/Y 各方向へ 5 cm 内側に中心を配置する。
      通常時は主輪へ十分な荷重がかかるよう、補助球は地面から5 mm浮かせる。
      後で実機のキャスター構造が確定したら、
      swivel + wheel の2軸構造へ置き換え可能。
    -->
    <xacro:property name="caster_radius" value="0.05" />
    <xacro:property name="caster_mass" value="0.05" />
    <xacro:property name="caster_inset" value="0.05" />

    <!--
      補助球は通常走行時に主輪の荷重を奪わないよう、
      地面から 5 mm 浮かせる。
    -->
    <xacro:property name="caster_ground_clearance" value="0.005" />

    <!-- VLP-16 -->
    <xacro:property name="vlp_bottom_height_from_ground" value="0.43" />
    <xacro:property name="vlp_height" value="0.07" />

    <!-- =========================
         Derived geometry
         ========================= -->

    <!-- base_link の地上高 -->
    <xacro:property
      name="base_link_height_from_ground"
      value="${base_bottom_clearance + base_height/2}" />

    <!-- 主輪中心位置 -->
    <xacro:property
      name="wheel_center_z"
      value="${wheel_radius - base_link_height_from_ground}" />

    <xacro:property
      name="wheel_y"
      value="${wheel_separation/2}" />

    <!-- 補助輪中心位置 -->
    <xacro:property
      name="caster_center_z"
      value="${caster_radius + caster_ground_clearance - base_link_height_from_ground}" />

    <xacro:property
      name="caster_x"
      value="${base_length/2 - caster_inset}" />

    <xacro:property
      name="caster_y"
      value="${base_width/2 - caster_inset}" />

    <!-- VLP-16 center relative to base_link -->
    <xacro:property
      name="vlp_center_z"
      value="${vlp_bottom_height_from_ground + vlp_height/2 - base_link_height_from_ground}" />

    <!-- =========================
         Base link
         ========================= -->
    <link name="${prefix}base_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}" />
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}" />
        </geometry>
        <material name="orange" />
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${base_mass}" />
        <inertia
          ixx="${base_mass / 12.0 * (base_width*base_width + base_height*base_height)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${base_mass / 12.0 * (base_length*base_length + base_height*base_height)}"
          iyz="0.0"
          izz="${base_mass / 12.0 * (base_length*base_length + base_width*base_width)}" />
      </inertial>
    </link>

    <!-- =========================
         Left wheel
         ========================= -->
    <joint name="${prefix}left_wheel_joint" type="continuous">
      <parent link="${prefix}base_link" />
      <child link="${prefix}left_wheel" />
      <origin xyz="0 ${wheel_y} ${wheel_center_z}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.2" />
      <limit effort="100" velocity="5.0" />
    </joint>

    <link name="${prefix}left_wheel">
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder length="${wheel_len}" radius="${wheel_radius}" />
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder length="${wheel_len}" radius="${wheel_radius}" />
        </geometry>
        <material name="black" />
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <mass value="${wheel_mass}" />
        <inertia
          ixx="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}"
          iyz="0.0"
          izz="${wheel_mass / 2.0 * wheel_radius*wheel_radius}" />
      </inertial>
    </link>

    <!-- =========================
         Right wheel
         ========================= -->
    <joint name="${prefix}right_wheel_joint" type="continuous">
      <parent link="${prefix}base_link" />
      <child link="${prefix}right_wheel" />
      <origin xyz="0 -${wheel_y} ${wheel_center_z}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.2" />
      <limit effort="100" velocity="5.0" />
    </joint>

    <link name="${prefix}right_wheel">
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder length="${wheel_len}" radius="${wheel_radius}" />
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder length="${wheel_len}" radius="${wheel_radius}" />
        </geometry>
        <material name="black" />
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <mass value="${wheel_mass}" />
        <inertia
          ixx="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}"
          iyz="0.0"
          izz="${wheel_mass / 2.0 * wheel_radius*wheel_radius}" />
      </inertial>
    </link>

    <!-- =========================
         Auxiliary wheels
         Simplified as ball casters
         ========================= -->

    <!-- Front Left -->
    <joint name="${prefix}front_left_caster_joint" type="fixed">
      <parent link="${prefix}base_link" />
      <child link="${prefix}front_left_caster" />
      <origin xyz="${caster_x} ${caster_y} ${caster_center_z}" rpy="0 0 0" />
    </joint>

    <link name="${prefix}front_left_caster">
      <collision>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <visual>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="black" />
      </visual>
      <inertial>
        <mass value="${caster_mass}" />
        <inertia
          ixx="${2.0/5.0 * caster_mass * caster_radius * caster_radius}"
          ixy="0.0"
          ixz="0.0"
          iyy="${2.0/5.0 * caster_mass * caster_radius * caster_radius}"
          iyz="0.0"
          izz="${2.0/5.0 * caster_mass * caster_radius * caster_radius}" />
      </inertial>
    </link>

    <!-- Front Right -->
    <joint name="${prefix}front_right_caster_joint" type="fixed">
      <parent link="${prefix}base_link" />
      <child link="${prefix}front_right_caster" />
      <origin xyz="${caster_x} -${caster_y} ${caster_center_z}" rpy="0 0 0" />
    </joint>

    <link name="${prefix}front_right_caster">
      <collision>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <visual>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="black" />
      </visual>
      <inertial>
        <mass value="${caster_mass}" />
        <inertia
          ixx="${2.0/5.0 * caster_mass * caster_radius * caster_radius}"
          ixy="0.0"
          ixz="0.0"
          iyy="${2.0/5.0 * caster_mass * caster_radius * caster_radius}"
          iyz="0.0"
          izz="${2.0/5.0 * caster_mass * caster_radius * caster_radius}" />
      </inertial>
    </link>

    <!-- Rear Left -->
    <joint name="${prefix}rear_left_caster_joint" type="fixed">
      <parent link="${prefix}base_link" />
      <child link="${prefix}rear_left_caster" />
      <origin xyz="-${caster_x} ${caster_y} ${caster_center_z}" rpy="0 0 0" />
    </joint>

    <link name="${prefix}rear_left_caster">
      <collision>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <visual>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="black" />
      </visual>
      <inertial>
        <mass value="${caster_mass}" />
        <inertia
          ixx="${2.0/5.0 * caster_mass * caster_radius * caster_radius}"
          ixy="0.0"
          ixz="0.0"
          iyy="${2.0/5.0 * caster_mass * caster_radius * caster_radius}"
          iyz="0.0"
          izz="${2.0/5.0 * caster_mass * caster_radius * caster_radius}" />
      </inertial>
    </link>

    <!-- Rear Right -->
    <joint name="${prefix}rear_right_caster_joint" type="fixed">
      <parent link="${prefix}base_link" />
      <child link="${prefix}rear_right_caster" />
      <origin xyz="-${caster_x} -${caster_y} ${caster_center_z}" rpy="0 0 0" />
    </joint>

    <link name="${prefix}rear_right_caster">
      <collision>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <visual>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="black" />
      </visual>
      <inertial>
        <mass value="${caster_mass}" />
        <inertia
          ixx="${2.0/5.0 * caster_mass * caster_radius * caster_radius}"
          ixy="0.0"
          ixz="0.0"
          iyy="${2.0/5.0 * caster_mass * caster_radius * caster_radius}"
          iyz="0.0"
          izz="${2.0/5.0 * caster_mass * caster_radius * caster_radius}" />
      </inertial>
    </link>

    <!-- =========================
         Velodyne VLP-16
         ========================= -->
    <joint name="${prefix}scan_joint" type="fixed">
      <parent link="${prefix}base_link" />
      <child link="${prefix}velodyne" />
      <origin xyz="0 0 ${vlp_center_z}" rpy="0 0 0" />
    </joint>

    <link name="${prefix}velodyne">
      <!--
        外部 mesh の package:// 解決問題を避けるため、
        現段階では簡易円筒モデルとしている。
      -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder length="${vlp_height}" radius="0.052" />
        </geometry>
        <material name="black" />
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder length="${vlp_height}" radius="0.052" />
        </geometry>
      </collision>

      <inertial>
        <mass value="0.114" />
        <origin xyz="0 0 0" />
        <inertia
          ixx="0.001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.001"
          iyz="0.0"
          izz="0.001" />
      </inertial>
    </link>

    <!-- =========================
         IMU
         ========================= -->
    <joint name="${prefix}imu_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}imu_link"/>
      <origin xyz="0.093 0.020 -0.014" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}imu_link"/>

    <!-- =========================
         Camera physical frame
         ========================= -->
    <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}camera_link"/>
      <origin xyz="0.270 0.000 0.338" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}camera_link"/>

    <!-- Camera optical frame
         レンズ先端はカメラ基板より約2.5 cm前方。
         現段階では optical frame をレンズ先端付近に仮置きする。
         よって base_link からの x は約0.295 m。
         光学中心の厳密位置は後で実機に合わせて調整可能。
    -->
    <joint name="${prefix}camera_optical_joint" type="fixed">
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_optical_frame"/>
      <origin xyz="0.025 0 0" rpy="-${PI/2} 0 -${PI/2}"/>
    </joint>

    <link name="${prefix}camera_optical_frame"/>

  </xacro:macro>

  <!-- =========================
       Robot instance
       ========================= -->
  <xacro:diffbot prefix="" />

  <!-- =========================
       ros2_control
       ========================= -->
  <xacro:diffbot_ros2_control
    name="DiffBot"
    prefix=""
    use_mock_hardware="$(arg use_mock_hardware)" />

</robot>
